# Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend API
API_BASE_URL=http://localhost:8080
API_PORT=8080

# Frontend
FRONTEND_PORT=8000
FRONTEND_HOST=localhost

# DNS Configuration
DNS_DOMAIN=cybermap.local
DNS_SERVER=127.0.0.1
DNS_PORT=53

# Map Configuration
MAP_CENTER_LAT=20
MAP_CENTER_LNG=0
MAP_ZOOM=2
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Update Intervals (milliseconds)
UPDATE_INTERVAL=5000
PACKET_UPDATE_INTERVAL=100

# CORS
CORS_ENABLED=true
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info
LOG_FILE=app.log

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ctf_gis
MONGODB_TIMEOUT=10
